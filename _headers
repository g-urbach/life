# Extensionless HTML files — must declare Content-Type explicitly (deploy-v84)
/privacy
  Content-Type: text/html; charset=utf-8
/terms
  Content-Type: text/html; charset=utf-8
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(), geolocation=(), payment=(), usb=(), microphone=(self)
  Content-Security-Policy: default-src 'self'; script-src 'sha256-oxbnf8Ed2KP79LFzIOa/OjUJ+lZSoywJcfSJ1F2u2kw=' 'self' cdn.jsdelivr.net cdnjs.cloudflare.com unpkg.com *.cloudflare.com *.cloudfront.net static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' https:; font-src 'self' data:; frame-src 'none'; object-src 'none'; base-uri 'self'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
