# ============================================================
# Cloudflare Pages — Security Headers
# LifeTold v7.48 | Deploy to repo root alongside index.html
# ============================================================
# PRV-09: Content Security Policy
# SEC-19: HSTS
# SEC-09: CSP / X-Content-Type-Options / X-Frame-Options
#
# IMPORTANT — inline event handlers (onclick=):
#   All onclick= attributes have been migrated to addEventListener()
#   as of v5.74 (PRV-09 Build C complete). 'unsafe-inline' has been
#   removed from script-src 'sha256-oTQ0qGVjFKJ4fJWnxik+7NDm/UgYFZGxgt5zvxCVDfY=' 'sha256-hKVZsxAEzZH4KkMaM1mqK/JnEyiDKXyEOXXJU3XBZXk='. SEC-09 hardening step complete.
#
# IMPORTANT — hash maintenance (fixed 2026-07-10):
# The two tokens in script-src cover the two remaining
# inline <script> blocks (Peecho injector + app constants/logic).
# deploy-v128's patchScriptSrcHashes() rewrites BOTH tokens on every
# deploy, replacing whatever sha256- tokens are present (regardless of
# position/count) with the two freshly computed ones. Do not hand-edit
# these hash values — they will be overwritten on next deploy. Do NOT
# duplicate hash tokens or leave old ones behind; previously this file
#   drifted to four stale/duplicate tokens (v5.77-era) because the old
#   patch regex only replaced a contiguous leading run.
#
# HOW TO UPDATE CSP (non-hash changes):
#   If you add a new CDN or edge function origin, add it to the
#   relevant -src directive below. Test in browser devtools
#   (Console → CSP violations) before merging.
# ============================================================

# Extensionless HTML files — must declare Content-Type explicitly (deploy-v84)
/privacy
  Content-Type: text/html; charset=utf-8
/terms
  Content-Type: text/html; charset=utf-8

/*
  # Strict-Transport-Security — SEC-19
  # Tells browsers to always use HTTPS for this domain.
  # max-age=31536000 = 1 year. includeSubDomains covers all subdomains.
  # preload: submit lifetold.app to hstspreload.org once stable.
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # X-Frame-Options — prevents clickjacking
  X-Frame-Options: DENY

  # X-Content-Type-Options — prevents MIME sniffing
  X-Content-Type-Options: nosniff

  # Referrer-Policy — don't leak URL to third parties
  Referrer-Policy: strict-origin-when-cross-origin

  # Access-Control-Expose-Headers — PRV-09 fix (2026-07)
  # Content-Security-Policy is not a CORS-safelisted response header, so
  # cross-origin fetch() calls (e.g. the deployer's own live PRV-09 check
  # reading this site from a different origin) cannot read it via
  # res.headers.get('content-security-policy') unless it's explicitly
  # exposed here. Access-Control-Allow-Origin alone does NOT do this —
  # it only permits the request, it doesn't expose non-safelisted headers.
  # Without this line, the header is genuinely being sent (visible in
  # DevTools/curl) but invisible to JS running on another origin, which
  # is what made PRV-09's live CSP check fail even though CSP was deployed
  # and working correctly for real page loads.
  Access-Control-Expose-Headers: Content-Security-Policy

  # Permissions-Policy — disable features the app doesn't use
  # microphone is deliberately allowed (memoir dictation feature)
  Permissions-Policy: camera=(), geolocation=(), payment=(), usb=(), microphone=(self)

  # Content-Security-Policy — PRV-09 / SEC-09
  #
  # script-src:
  #   'sha256-...' 'sha256-...'      — hashes for the two remaining inline <script> blocks
  #                                     (Peecho injector + app constants/logic). Auto-patched
  #                                     on every deploy — see header comment above.
  #   cdn.jsdelivr.net               — Supabase JS, d3-dtree, DOMPurify
  #   cdnjs.cloudflare.com           — jsPDF, D3, lodash
  #   unpkg.com                      — Supabase fallback CDN
  #   *.cloudflare.com               — Cloudflare email-decode script (cdn-cgi)
  #   *.cloudfront.net               — Peecho Button script (wildcard covers all CF subdomains)
  #   static.cloudflareinsights.com  — Cloudflare Web Analytics beacon (auto-injected by Pages)
  #
  # connect-src:
  #   *.supabase.co                  — database, auth, storage, edge functions
  #   www.peecho.com                 — Peecho hosted checkout
  #   wss://*.supabase.co            — Supabase realtime websocket
  #   https://archive.org            — Internet Archive CC0 music MP3 fetch (redirects to *.archive.org CDN nodes)
  #   *.jsdelivr.net cdnjs.cloudflare.com — sourcemap fetches from CDN scripts (suppresses console noise)
  #
  # manifest-src:
  #   blob:                          — PWA manifest generated as blob: URL by service worker
  #
  # img-src:
  #   'self' data: blob:             — app images, data URIs, generated blobs
  #   *.supabase.co                  — user-uploaded photos served from storage
  #
  # font-src:
  #   fonts.gstatic.com              — Google Fonts (Playfair Display, Lato)
  #
  # style-src:
  #   'self' 'unsafe-inline'         — inline <style> blocks
  #   fonts.googleapis.com           — Google Fonts stylesheet
  #
  # frame-ancestors: 'none' — belt-and-braces with X-Frame-Options
  Content-Security-Policy: default-src 'none'; script-src 'sha256-oTQ0qGVjFKJ4fJWnxik+7NDm/UgYFZGxgt5zvxCVDfY=' 'sha256-i+cA13LmJXRHTXwR4ruYOrXF7+qJkzAkKT4DF6qxOFg=' 'self' cdn.jsdelivr.net cdnjs.cloudflare.com unpkg.com *.cloudflare.com *.cloudfront.net static.cloudflareinsights.com; connect-src 'self' *.supabase.co www.peecho.com wss://*.supabase.co https://archive.org https://*.archive.org *.jsdelivr.net cdnjs.cloudflare.com; img-src 'self' data: blob: *.supabase.co; font-src 'self' fonts.gstatic.com; style-src 'self' 'unsafe-inline' fonts.googleapis.com; manifest-src blob:; frame-ancestors 'none'; form-action 'self'; base-uri 'self'
