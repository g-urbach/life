# Extensionless HTML files — must declare Content-Type explicitly so
# Cloudflare Pages renders them in the browser rather than as downloads.
# (fixed deploy-v83/v84 — Cloudflare auto-308 strips .html extensions)
/privacy
  Content-Type: text/html; charset=utf-8

/terms
  Content-Type: text/html; charset=utf-8

/*
  # Strict-Transport-Security — SEC-19
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

  # X-Frame-Options — prevents clickjacking
  X-Frame-Options: DENY

  # X-Content-Type-Options — prevents MIME sniffing
  X-Content-Type-Options: nosniff

  # Referrer-Policy — don't leak URL to third parties
  Referrer-Policy: strict-origin-when-cross-origin

  # Permissions-Policy — disable features the app doesn't use
  # microphone is deliberately allowed (memoir dictation feature)
  Permissions-Policy: camera=(), geolocation=(), payment=(), usb=(), microphone=(self)

  # Content-Security-Policy — PRV-09 / SEC-09
