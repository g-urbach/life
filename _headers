# Extensionless HTML files — must declare Content-Type explicitly (deploy-v84)
/privacy
  Content-Type: text/html; charset=utf-8
/terms
  Content-Type: text/html; charset=utf-8

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-NxlhAFtUqp3XorGJDwK99lf7fseI/nyQ9Qx5ac4SgOs=' *.cloudfront.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' https:; font-src 'self' data:; frame-src 'none'; object-src 'none'; base-uri 'self'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin